---
interface Props {
  title: string;
  description: string;
  techStack: string[];
  category?: string;
  number: string;
  repoUrl?: string;
  videoUrl?: string;
  status?: string;
}

const { title, description, techStack, category, number, repoUrl, videoUrl, status } = Astro.props;
---

<article
  class="group relative bg-cyber-gray border border-white/5
         hover:border-neon-green/40 transition-all duration-300 overflow-hidden
         hover:shadow-[0_0_35px_rgba(0,255,65,0.08)]"
>
  <!-- Corner bracket accents -->
  <div
    class="absolute top-0 left-0 w-10 h-10 border-t-2 border-l-2
           border-transparent group-hover:border-neon-green/60 transition-colors duration-300"
  ></div>
  <div
    class="absolute bottom-0 right-0 w-10 h-10 border-b-2 border-r-2
           border-transparent group-hover:border-neon-green/30 transition-colors duration-300"
  ></div>

  <!-- Top glow line -->
  <div
    class="absolute top-0 left-0 right-0 h-px bg-neon-green/0
           group-hover:bg-neon-green/50 transition-all duration-300"
  ></div>

  <div class="p-8">
    <!-- Number + Category row -->
    <div class="flex items-center justify-between mb-4">
      <p class="text-xs font-mono text-gray-500">
        {number}.{category ? ` ${category.toUpperCase()}` : ''}
      </p>

      <!-- Repo link icon (decorative arrow if no repo) -->
      {repoUrl ? (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${title} source code (opens in new tab)`}
          class="text-gray-700 hover:text-neon-green transition-colors duration-200"
        >
          <svg aria-hidden="true" class="w-4 h-4 translate-x-0 -translate-y-0 hover:translate-x-0.5 hover:-translate-y-0.5 transition-transform duration-200"
               fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        <svg aria-hidden="true"
             class="w-4 h-4 text-gray-700 group-hover:text-neon-green group-hover:translate-x-0.5 group-hover:-translate-y-0.5
                    transition-all duration-300"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      )}
    </div>

    <!-- Title -->
    <h3
      class="text-2xl font-bold text-white group-hover:text-neon-green
             transition-colors duration-300 mb-3 tracking-tight"
    >
      {title}
    </h3>

    <!-- Status badge -->
    {status && (
      <p class="inline-flex items-center gap-1.5 font-mono text-xs text-neon-green/70
                border border-neon-green/20 bg-neon-green/5 px-2.5 py-1 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-neon-green/60 animate-pulse"></span>
        {status}
      </p>
    )}

    <!-- Description -->
    <p class="text-gray-400 leading-relaxed text-sm mb-6">
      {description}
    </p>

    <!-- Tech stack tags -->
    <div class="flex flex-wrap gap-2 mb-5">
      {techStack.map((tech) => (
        <span
          class="text-xs font-mono px-2.5 py-1 bg-black/40 border border-white/10 text-gray-500
                 group-hover:border-neon-green/20 group-hover:text-neon-green/70
                 transition-colors duration-300"
        >
          {tech}
        </span>
      ))}
    </div>

    <!-- Action links (repo + video) -->
    {(repoUrl || videoUrl) && (
      <div class="flex items-center gap-4 pt-4 border-t border-white/5">
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`View ${title} source code (opens in new tab)`}
            class="flex items-center gap-1.5 font-mono text-xs text-gray-500
                   hover:text-neon-green transition-colors duration-200"
          >
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577
                       0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755
                       -1.087-.744.084-.73.084-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998
                       .108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22
                       -.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405
                       1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176
                       .765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22
                       0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12
                       c0-6.627-5.373-12-12-12z"/>
            </svg>
            Source Code
          </a>
        )}
        {videoUrl && (
          <a
            href={videoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Watch ${title} demo on LinkedIn (opens in new tab)`}
            class="flex items-center gap-1.5 font-mono text-xs text-gray-500
                   hover:text-neon-green transition-colors duration-200"
          >
            <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Watch Demo
          </a>
        )}
      </div>
    )}
  </div>
</article>
