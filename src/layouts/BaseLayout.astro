---
const { title = "Developer | Portfolio" } = Astro.props;
import '../styles/global.css';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
  </head>
  <body class="selection:bg-neon-green selection:text-black">
    <nav class="p-6 flex justify-between items-center sticky top-0 bg-cyber-black/80 backdrop-blur-md z-50 border-b border-white/5">
      <a href="/" class="font-mono text-neon-green font-bold text-xl tracking-tighter hover:opacity-80 transition-opacity">./rayan</a>
      <div class="flex items-center gap-5 sm:gap-8 font-mono text-xs sm:text-sm uppercase tracking-widest">
        <a href="#projects" class="hover:text-neon-green transition-colors text-white/50 hover:text-white">Projects</a>
        <a href="#stack" class="hover:text-neon-green transition-colors text-white/50 hover:text-white hidden sm:inline">Stack</a>
        <a href="mailto:rayanjaved6@gmail.com"
           aria-label="Send me an email"
           class="text-neon-green border border-neon-green/30 px-3 py-1 sm:px-4 hover:bg-neon-green hover:text-black transition-all">
          Contact
        </a>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6">
      <slot />
    </main>

    <footer class="py-12 border-t border-white/5 mt-20">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="font-mono text-xs text-white/30 tracking-widest uppercase">
          Terminal Access Granted // 2026
        </p>
        <address class="not-italic font-mono text-xs text-gray-500 text-center sm:text-right leading-relaxed">
          <span class="text-gray-400">Rayan Javed Siddiqi</span>
          <span class="text-white/20 mx-2">|</span>
          <a href="tel:+923104235599"
             aria-label="Call Rayan"
             class="hover:text-neon-green transition-colors">
            +92 310 4235599
          </a>
          <span class="text-white/20 mx-2">|</span>
          <a href="mailto:rayanjaved6@gmail.com"
             aria-label="Email Rayan"
             class="hover:text-neon-green transition-colors">
            rayanjaved6@gmail.com
          </a>
        </address>
      </div>
    </footer>
  </body>
</html>