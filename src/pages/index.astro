---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="Home | Professional Portfolio">

  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="py-24 md:py-40 flex flex-col items-start min-h-[88vh] justify-center">
    <div class="space-y-8 max-w-4xl w-full">

      <p class="font-mono text-neon-green tracking-widest text-xs animate-pulse">
        [ SYSTEM INITIALIZED // VERSION 1.0.4 ]
      </p>

      <h1 class="text-5xl sm:text-6xl md:text-8xl font-bold text-white tracking-tighter leading-none">
        I build
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-neon-green to-cyan-400">
          efficient systems.
        </span>
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl text-gray-400 font-sans max-w-2xl leading-relaxed">
        CS sophomore at FAST-NUCES, Lahore — bridging
        <span class="text-white border-b border-neon-green/30">low-level systems</span>
        and modern full-stack &amp; AI-driven web development.
      </p>

      <div class="pt-4 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="bg-neon-green text-black font-bold px-8 py-4 uppercase tracking-tighter
                 hover:scale-105 active:scale-100 transition-transform duration-150 text-sm"
        >
          View Projects
        </a>
        <a
          href="/Rayan_Javed_Resume.docx"
          download="Rayan_Javed_Resume.docx"
          class="border border-white/20 text-white px-8 py-4 uppercase tracking-tighter text-sm
                 hover:bg-white/5 hover:border-white/40 transition-all duration-200"
        >
          Download CV
        </a>
      </div>

      <!-- Quick stats -->
      <div class="pt-8 grid grid-cols-3 gap-6 max-w-sm border-t border-white/5">
        {[
          { value: '2+', label: 'Years Coding' },
          { value: '5+', label: 'Projects' },
          { value: '10+', label: 'Technologies' },
        ].map(({ value, label }) => (
          <div>
            <p class="font-mono text-neon-green text-2xl font-bold">{value}</p>
            <p class="text-gray-500 text-xs uppercase tracking-widest mt-1">{label}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ─── PROJECTS ──────────────────────────────────────────── -->
  <section id="projects" class="py-20 border-t border-white/5">

    <div class="mb-14">
      <h2 class="font-mono text-neon-green text-xl italic mb-2">// Major_Projects</h2>
      <p class="text-gray-500 text-sm tracking-wide max-w-md">
        Selected work — from low-level systems to AI-powered tooling.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          techStack={project.data.techStack}
          category={project.data.category}
          number={String(i + 1).padStart(2, '0')}
          repoUrl={project.data.repoUrl}
          liveUrl={project.data.liveUrl}
          videoUrl={project.data.videoUrl}
          status={project.data.status}
        />
      ))}
    </div>

  </section>

  <!-- ─── TECH STACK ────────────────────────────────────────── -->
  <section id="stack" class="py-20 border-t border-white/5">

    <h2 class="font-mono text-neon-green text-xl italic mb-12">// Tech_Stack</h2>

    <div class="flex flex-wrap gap-3">
      {[
        { name: 'Python',              label: 'Lang'    },
        { name: 'C++',                 label: 'Lang'    },
        { name: 'TypeScript',          label: 'Lang'    },
        { name: 'Django / DRF',        label: 'FW'      },
        { name: 'Next.js / React',     label: 'FW'      },
        { name: 'Streamlit',           label: 'FW'      },
        { name: 'Google Gemini',       label: 'AI'      },
        { name: 'SQL / Prisma',        label: 'DB'      },
        { name: 'SFML',                label: 'Graphics'},
        { name: 'Git / Vercel',        label: 'Tools'   },
      ].map(({ name, label }) => (
        <div
          class="group flex items-center gap-2 px-4 py-2.5 border border-white/10 bg-cyber-gray
                 hover:border-neon-green/50 hover:bg-black/40
                 transition-all duration-200 cursor-default"
        >
          <span class="text-xs font-mono text-gray-700 group-hover:text-neon-green/50 transition-colors">
            [{label}]
          </span>
          <span class="text-sm font-medium text-gray-400 group-hover:text-white transition-colors tracking-wide">
            {name}
          </span>
        </div>
      ))}
    </div>

  </section>

  <!-- ─── CONTACT ───────────────────────────────────────────── -->
  <section id="contact" class="py-20 border-t border-white/5">

    <div class="max-w-2xl">
      <h2 class="font-mono text-neon-green text-xl italic mb-4">// Get_In_Touch</h2>
      <p class="text-gray-400 leading-relaxed mb-10 text-lg">
        Open to internships, collaborations, and interesting problems.
        <span class="text-white"> Let's build something.</span>
      </p>

      <div class="flex flex-col sm:flex-row gap-4">

        <!-- GitHub -->
        <a
          href="https://github.com/Rayan-Javed-Siddiqi"
          target="_blank" rel="noopener noreferrer"
          aria-label="Visit my GitHub profile (opens in new tab)"
          class="group flex items-center gap-3 px-7 py-4 border border-white/10 bg-cyber-gray
                 hover:border-neon-green/50 hover:bg-black/40 transition-all duration-200"
        >
          <svg aria-hidden="true" class="w-5 h-5 text-gray-500 group-hover:text-neon-green transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577
                     0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755
                     -1.087-.744.084-.73.084-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998
                     .108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22
                     -.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405
                     1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176
                     .765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22
                     0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.298 24 12
                     c0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="font-mono text-sm text-gray-400 group-hover:text-white transition-colors tracking-wider uppercase">
            GitHub
          </span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/rayan-javed-2b0394297"
          target="_blank" rel="noopener noreferrer"
          aria-label="Visit my LinkedIn profile (opens in new tab)"
          class="group flex items-center gap-3 px-7 py-4 border border-white/10 bg-cyber-gray
                 hover:border-neon-green/50 hover:bg-black/40 transition-all duration-200"
        >
          <svg aria-hidden="true" class="w-5 h-5 text-gray-500 group-hover:text-neon-green transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939
                     v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455
                     v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019
                     H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24
                     h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span class="font-mono text-sm text-gray-400 group-hover:text-white transition-colors tracking-wider uppercase">
            LinkedIn
          </span>
        </a>

      </div>
    </div>

  </section>

</BaseLayout>
